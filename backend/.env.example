# 后端运行环境变量示例
# 复制为 .env 后填入真实值，切勿提交到 Git。

NODE_ENV=production
PORT=3001

# SQLite 示例（本地开发）
# DATABASE_URL="file:./prisma/dev.db"
# 生产环境建议把数据库放在代码目录外，避免更新时被覆盖：
# DATABASE_URL="file:/opt/soulsentry/data/china.db"

JWT_SECRET=replace_with_a_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# 前端域名，多个用逗号分隔
CORS_ORIGIN=https://www.xinzhan-soulsentry.cn,https://xinzhan-soulsentry.cn

# 上传文件保存目录
UPLOAD_DIR=uploads

# Web Push 必需：VAPID 密钥对
# 生成方式：npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Kimi / Moonshot AI（至少配置一个，否则 AI 功能不可用）
KIMI_API_KEY=sk-your_china_kimi_key
KIMI_BASE_URL=https://api.moonshot.cn/v1

# 可选：国际备用链路
KIMI_FALLBACK_API_KEY=sk-your_global_kimi_key
KIMI_FALLBACK_BASE_URL=https://api.moonshot.ai/v1

# 微信支付（可选）
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_SERIAL_NO=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_NOTIFY_URL=

# 微信小程序订阅消息（可选，未配置时仍走应用内提醒）
# 登录 https://mp.weixin.qq.com -> 功能 -> 订阅消息 获取模板 ID
WECHAT_APP_SECRET=
WECHAT_SUBSCRIBE_REMINDER_TMPL_ID=
WECHAT_SUBSCRIBE_FOLLOWUP_TMPL_ID=

# 若订阅消息模板的字段名与默认不一致，可在此覆盖
# 默认：提醒 thing1/thing2/time3，跟进 thing1/time2/thing3
WECHAT_SUBSCRIBE_REMINDER_TITLE_FIELD=
WECHAT_SUBSCRIBE_REMINDER_DESC_FIELD=
WECHAT_SUBSCRIBE_REMINDER_TIME_FIELD=
WECHAT_SUBSCRIBE_FOLLOWUP_TITLE_FIELD=
WECHAT_SUBSCRIBE_FOLLOWUP_TIME_FIELD=
WECHAT_SUBSCRIBE_FOLLOWUP_NOTE_FIELD=

# 阿里云短信（可选）
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION_ID=cn-hangzhou
