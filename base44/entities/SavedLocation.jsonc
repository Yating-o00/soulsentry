{
  "name": "SavedLocation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u5730\u70b9\u540d\u79f0\uff0c\u5982\uff1a\u516c\u53f8\u3001\u5bb6\u3001\u5065\u8eab\u623f"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u8865\u5145\u8bf4\u660e\uff08\u53ef\u9009\uff09"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "home",
        "office",
        "gym",
        "school",
        "shopping",
        "hospital",
        "restaurant",
        "other"
      ],
      "default": "other",
      "description": "\u5730\u70b9\u7c7b\u578b"
    },
    "latitude": {
      "type": "number",
      "description": "\u7eac\u5ea6"
    },
    "longitude": {
      "type": "number",
      "description": "\u7ecf\u5ea6"
    },
    "radius": {
      "type": "number",
      "default": 200,
      "description": "\u5730\u7406\u56f4\u680f\u534a\u5f84\uff08\u7c73\uff09"
    },
    "address": {
      "type": "string",
      "description": "\u8be6\u7ec6\u5730\u5740"
    },
    "icon": {
      "type": "string",
      "default": "\ud83d\udccd",
      "description": "\u663e\u793a\u56fe\u6807"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u662f\u5426\u542f\u7528\u8be5\u5730\u70b9\u7684\u56f4\u680f\u63d0\u9192"
    },
    "trigger_on": {
      "type": "string",
      "enum": [
        "enter",
        "exit",
        "both"
      ],
      "default": "enter",
      "description": "\u89e6\u53d1\u65b9\u5f0f\uff1a\u8fdb\u5165/\u79bb\u5f00/\u4e24\u8005"
    },
    "last_entered_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u6700\u8fd1\u4e00\u6b21\u8fdb\u5165\u65f6\u95f4"
    },
    "last_exited_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u6700\u8fd1\u4e00\u6b21\u79bb\u5f00\u65f6\u95f4"
    },
    "quiet_minutes": {
      "type": "number",
      "default": 30,
      "description": "\u9759\u9ed8\u671f\uff08\u5206\u949f\uff09"
    },
    "quiet_policy": {
      "type": "object",
      "description": "\u901a\u77e5\u9759\u9ed8\u7b56\u7565",
      "properties": {
        "merge_mode": {
          "type": "string",
          "enum": [
            "none",
            "merge",
            "first_only",
            "last_only"
          ],
          "default": "merge",
          "description": "\u5408\u5e76\u6a21\u5f0f"
        },
        "cooldown_minutes": {
          "type": "number",
          "default": 30,
          "description": "\u51b7\u5374\u65f6\u957f\uff08\u5206\u949f\uff09"
        },
        "merge_window_minutes": {
          "type": "number",
          "default": 10,
          "description": "\u5408\u5e76\u7a97\u53e3\uff08\u5206\u949f\uff09"
        },
        "max_per_day": {
          "type": "number",
          "default": 5,
          "description": "\u6bcf\u65e5\u901a\u77e5\u4e0a\u9650\uff08\u540c\u4e00\u5730\u70b9\uff09"
        },
        "min_dwell_seconds": {
          "type": "number",
          "default": 60,
          "description": "\u6700\u5c0f\u505c\u7559\u79d2\u6570"
        },
        "quiet_hours_enabled": {
          "type": "boolean",
          "default": false,
          "description": "\u662f\u5426\u5f00\u542f\u514d\u6253\u6270\u65f6\u6bb5"
        },
        "quiet_hours_start": {
          "type": "string",
          "default": "22:00",
          "description": "\u514d\u6253\u6270\u5f00\u59cb\u65f6\u95f4\uff08HH:mm\uff09"
        },
        "quiet_hours_end": {
          "type": "string",
          "default": "08:00",
          "description": "\u514d\u6253\u6270\u7ed3\u675f\u65f6\u95f4\uff08HH:mm\uff09"
        }
      }
    },
    "notification_stats": {
      "type": "object",
      "description": "\u901a\u77e5\u7edf\u8ba1",
      "properties": {
        "last_notified_at": {
          "type": "string",
          "format": "date-time"
        },
        "today_count": {
          "type": "number",
          "default": 0
        },
        "today_date": {
          "type": "string",
          "description": "YYYY-MM-DD"
        },
        "pending_merge_count": {
          "type": "number",
          "default": 0,
          "description": "\u7b49\u5f85\u5408\u5e76\u53d1\u9001\u7684\u4e8b\u4ef6\u6570"
        },
        "pending_merge_started_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "required": [
    "name",
    "latitude",
    "longitude"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "write": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}