{
  "name": "Gmail \u65b0\u90ae\u4ef6 AI \u89e3\u6790",
  "description": "\u6536\u5230\u65b0\u90ae\u4ef6\u65f6\uff0cAI \u89e3\u6790\u4f1a\u8bae/\u5f85\u529e\u4fe1\u606f\u5e76\u751f\u6210\u5fc3\u7b7e\u4e0e\u901a\u77e5",
  "trigger": {
    "condition": "${ (.trigger.data.has_new_messages == true) }",
    "config": {
      "trigger_type": "connector",
      "events": [
        "mailbox"
      ],
      "integration_type": "gmail",
      "resource_id": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "gmail_ai",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "handleGmailWebhook",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "handleGmailWebhook"
  }
}