{
  "name": "CollabMessage",
  "type": "object",
  "description": "\u534f\u540c\u7a7a\u95f4\u5185\u7684\u8ba8\u8bba\u6d88\u606f\uff08\u6210\u5458\u6216 Agent\uff09",
  "properties": {
    "space_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "is_agent": {
      "type": "boolean",
      "default": false
    },
    "content": {
      "type": "string"
    },
    "tag": {
      "type": "string",
      "enum": [
        "none",
        "consensus",
        "divergence",
        "pending"
      ],
      "default": "none"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "space_id",
    "content"
  ],
  "rls": {
    "read": {
      "data.member_ids": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "update": {
      "data.member_ids": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}