{
  "name": "TrustPolicy",
  "type": "object",
  "description": "\u4fe1\u4efb\u9636\u68af\uff1a\u7528\u6237\u4e3a\u6bcf\u4e00\u7c7b\u81ea\u52a8\u6267\u884c\u64cd\u4f5c\u8bbe\u5b9a\u7684\u6258\u7ba1\u6863\u4f4d",
  "properties": {
    "automation_type": {
      "type": "string",
      "enum": [
        "email_draft",
        "file_organize",
        "web_research",
        "office_doc",
        "ppt_doc",
        "calendar_event",
        "summary_note",
        "ledger_organize"
      ],
      "description": "\u81ea\u52a8\u6267\u884c\u7c7b\u578b"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u8865\u5145\u8bf4\u660e\uff08\u53ef\u9009\uff09"
    },
    "tier": {
      "type": "string",
      "enum": [
        "confirm_first",
        "auto_draft",
        "full_auto"
      ],
      "default": "auto_draft",
      "description": "\u6258\u7ba1\u6863\u4f4d\uff1aconfirm_first=\u9700\u6211\u786e\u8ba4\u540e\u624d\u52a8\u624b / auto_draft=\u4f4e\u98ce\u9669\u81ea\u52a8\u505a\u51fa\u8349\u7a3f / full_auto=\u5b8c\u5168\u6258\u7ba1"
    },
    "updated_reason": {
      "type": "string",
      "description": "\u7528\u6237\u8c03\u6574\u6863\u4f4d\u65f6\u7684\u5907\u6ce8"
    }
  },
  "required": [
    "automation_type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "write": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}